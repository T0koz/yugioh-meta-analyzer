# Données brutes (trop lourdes pour Git)
data/raw/
data/*.db

# Environnement Python
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Fichiers temporaires
data/*.tmp
data/*.png
data/graph_combo_*.html

# Libs JS tierces (pyvis), régénérables
notebooks/lib/
/lib/

# Node (front Next.js)
node_modules/
.next/

# Outillage BMad — réinstallable, pas du code projet
# (_bmad-output/ est tracké : ce sont les livrables, pas l'outil)
# `_bmad/*` et non `_bmad/` : Git ne descend pas dans un dossier exclu, donc
# une exception sur un enfant ne serait jamais évaluée.
_bmad/*
# Seuls overrides que l'installeur BMad ne régénère pas. Le .gitignore imbriqué
# de ce dossier exclut déjà les *.user.toml (personnels).
!_bmad/custom/
.claude/skills/
.claude/settings.local.json

# OS
.DS_Store
logs/
data/fetch_health.jsonl
data/backup_*.db

# Identifiants (base hébergée, API…) : jamais commités, le dépôt est public.
# Un modèle sans valeurs peut être partagé sous le nom .env.example.
.env
.env.*
!.env.example

# Vercel : lien du projet, variables téléchargées par `vercel pull` (peuvent contenir un jeton),
# sortie de `vercel build` (.vercel/output). Jamais commités (TOK-35).
.vercel/

# Fichiers personnels de Thomas : jamais commités (dépôt public)
HANDOFF.md
docs/hebergement-multi-tcg.html
data/early_signal_*.html

# Images de cartes téléchargées (TOK-92) : jamais dans Git
data/card-images/

# Copie de la base de service embarquée dans l'API au déploiement Vercel (TOK-35) : jamais dans Git
backend/data/
