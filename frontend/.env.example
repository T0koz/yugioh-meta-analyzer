# Variables du front (aucun secret ici : tout ce qui commence par NEXT_PUBLIC_ est public).
# Copier en .env.local pour les modifier ; .env.local n'est jamais commité.

# Adresse de l'API FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Ordre de lecture (TOK-35, lib/api.ts, apiBaseUrl()) :
#   côté serveur (rendu, build) : API_URL, puis BACKEND_URL + /api/v1, puis NEXT_PUBLIC_API_URL,
#                                 puis http://localhost:8000/api/v1 ;
#   côté navigateur             : NEXT_PUBLIC_API_URL, puis http://localhost:8000/api/v1.
# En local, rien à définir : tout pointe sur http://localhost:8000/api/v1.
#
# API_URL : adresse ABSOLUE de l'API pour le serveur Next, lue à l'exécution et au build. Sert au
# build local de la voie 2 (scripts/deploy_prebuilt.py la passe à `vercel build`). Ne JAMAIS la
# créer dans les variables du projet Vercel : elle y masquerait BACKEND_URL.
# API_URL=http://localhost:8000/api/v1
#
# BACKEND_URL : adresse privée du service API, injectée par Vercel (liaison de service, vercel.json)
# à l'exécution seulement, jamais au build. Ne pas la définir soi-même.

# Adresse publique du site, sans barre finale. Sert aux liens canoniques, aux balises
# Open Graph, au sitemap et à robots.txt. Sans valeur : domaine de production Vercel
# s'il existe, sinon http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse de base des images de cartes (TOK-92), sans barre finale. Sans valeur : /card-images, servi
# en local depuis ../data/card-images (rempli par `python scripts/download_card_images.py`).
# Au déploiement : l'adresse du stockage définitif (TOK-35).
# NEXT_PUBLIC_CARD_IMAGES_URL=
# Dossier des images pour la route locale, si ce n'est pas ../data/card-images (utile dans un worktree).
# CARD_IMAGES_DIR=/chemin/vers/data/card-images

# --- Déploiement Vercel (TOK-35, docs/deploiement.md) ---
# En ligne, le navigateur appelle l'API par le même domaine : NEXT_PUBLIC_API_URL=/api/v1 (variable de
# build : à redéployer après un changement). BACKEND_URL (adresse privée de l'API) est injectée par Vercel
# dans le service frontend ; ne jamais la créer à la main.
# NEXT_PUBLIC_SITE_URL=https://<domaine de production>
# NEXT_PUBLIC_CARD_IMAGES_URL=https://<stockage des images>
