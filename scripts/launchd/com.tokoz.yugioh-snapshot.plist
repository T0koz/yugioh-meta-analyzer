<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tokoz.yugioh-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/thomascozian/code/yugioh-meta-analyzer/.venv/bin/python</string>
        <string>scripts/snapshot_prices.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/thomascozian/code/yugioh-meta-analyzer</string>

    <!-- Tous les jours à 9h12. Si le Mac dort à cette heure, launchd rattrape au réveil.
         Le script est idempotent : il ignore un jour déjà présent. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>12</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/thomascozian/Library/Logs/yugioh-snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/thomascozian/Library/Logs/yugioh-snapshot.log</string>
</dict>
</plist>
